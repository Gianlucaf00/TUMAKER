; ============================================================
; Configuration file for Duet
; Firmware: RepRapFirmware 3.6.x
; Generated by INDART3D – TUMAKER
; ============================================================

; -----------------------------
; Local variables
; -----------------------------
var Machine = "NX MODULAR"
var toolSide = {"Left","Right"}
var root = "0:/sys/"
var i = 0
var maxRetries = 100
var running = 0

; -----------------------------
; PanelDue
; -----------------------------
M575 P1 S1 B57600               ; PanelDue serial

; -----------------------------
; Global variables
; -----------------------------
if !exists(global.toolType)
	global toolType  = {"HR","HR"}                                    ; Tipo herramienta por extrusor
	global data      = {vector(5,null)}                               ; Datos generales máquina
	global area      = {300,300,250}                                  ; Área de impresión X,Y,Z
	global i18n      = {"EN","messageID","title","message","choice"}  ; internationalization: language and UI message fields

	global DaemonActive = {vector(#global.toolType,state.upTime)}     ; Timestamp último uso feeder
	global ContPellets = {vector(#global.toolType,-1)}                ; Contador fallos alimentación

; -----------------------------
; Network
; -----------------------------
set var.root = {"0:/data/Ethernet","0:/data/WiFi"}
set var.i = 0
while var.i < #var.root
	if fileexists(var.root[var.i])
		M98 P{var.root[var.i]}
	if exists(network.interfaces[var.i])
		M586 I{var.i} P0 S1     ; HTTP
		M586 I{var.i} P1 S0     ; FTP off
		M586 I{var.i} P2 S0     ; Telnet off
	set var.i = var.i + 1

; -----------------------------
; Migration execution lock
; -----------------------------
if fileexists("0:/sys/runonce_migrate.g")
	set var.Machine = var.Machine^" migrate"
	M550 P{var.Machine}
	M99

; -----------------------------
; Carga Valores Guardados
; -----------------------------
; Save data    {global.i18n[0],      global toolType,      global ContPellets,      global.data[0]}
set var.root = {"0:/data/language",  "0:/data/selecTool",  "0:/data/ActiveFeeder",  "0:/data/NS",}
set var.i = 0
while var.i < #var.root
	if fileexists(var.root[var.i])
		M98 P{var.root[var.i]}
	set var.i = var.i + 1

set var.Machine = var.Machine^" "^global.data[0]

; -----------------------------
; Motion system basics
; -----------------------------
M595 Q1 P10                     ; Input shaping (base)
M669 T0.1 S1                    ; Kinematics Cartesian

; -----------------------------
; Wait for secondary boards sync
; -----------------------------
while var.maxRetries > 0
	set var.running = 0
	set var.i = 1               ; board 0 = main board

	while var.i < #boards
		if boards[var.i].state == "running"
			set var.running = var.running + 1
		set var.i = var.i + 1

	if var.running == (#boards - 1)
		break

	G4 P100
	set var.maxRetries = var.maxRetries - 1
	M400

if var.running != (#boards - 1)
	echo "Timeout: not all secondary electronics are active"

; -----------------------------
; General preferences
; -----------------------------
G90                             ; Absolute positioning
M83                             ; Extruder relative
M550 P{var.Machine}             ; Machine name

; ============================================================
; DRIVES & MOTION
; ============================================================

; -----------------------------
; Driver directions
; -----------------------------
M569 P0.0 S0
M569 P0.1 S0
M569 P0.2 S0
M569 P0.3 S1
M569 P0.4 S1
M569 P0.5 S0
M569 P1.0 S0
M569 P1.1 S0
M569 P1.2 S0

; -----------------------------
; Drive mapping
; -----------------------------
M584 X0.4 Y0.3:0.1 Z1.0:1.1:1.2 U0.5 E0.0:0.2

; -----------------------------
; Microstepping
; -----------------------------
M350 I1 X16 Y16 Z1 U16 E16

; -----------------------------
; Motion tuning
; -----------------------------
M92  X100   Y100   Z100  U100  E397:250           ; Set axis steps per unit
M566 X600   Y600   Z60   U600   E8000:600         ; Set allowable instantaneous speed change (mm/min)
M201 X1000  Y1000  Z10   U1000  E8000:1200        ; Set max acceleration (mm/s^2)
M203 X24000 Y24000 Z400  U24000 E9000:6000        ; Set maximum feedrate (mm/min)
M906 X1530  Y1530  Z1064 U1530  E1000:2000 I30    ; Set motor currents (mA)
M84  S60                                          ; Set Idle Time-out

; -----------------------------
; Axis limits
; -----------------------------
M208 S1 X-96 Y-41.5 Z-1 U-10
M208 S0 X300 Y300 Z253 U396

; ============================================================
; ENDSTOPS & SENSORS
; ============================================================

M574 X1 S1 P"0.io2.in"
M574 Y1 S1 P"0.io1.in+0.io5.in"
M574 Z2 S1 P"^1.io2.in+^1.io1.in+^1.io0.in"
M574 U2 S1 P"0.io6.in"

; Sensor material
set var.root = "0:/data/MaterialSensorT"
set var.i = 0
while var.i < #global.toolType
	if fileexists(var.root^var.i)
		M98 P{var.root^var.i}
	set var.i = var.i + 1

; ============================================================
; HEATERS & TEMPERATURE
; ============================================================

M308 S0 P"1.temp2" Y"thermistor" T100000 B4138 A"BED"
M950 H0 C"1.out3" T0
M143 H0 S125
M307 H0 B1 S1.00
M570 H0 S0 P900 T45
M140 H0

M308 S1 P"0.temp0" Y"thermistor"
M950 H1 C"0.out1" T1
M143 H1 S300
M307 H1 B0 S1.00

M308 S2 P"0.temp1" Y"thermistor"
M950 H2 C"0.out2" T2
M143 H2 S300
M307 H2 B0 S1.00

M308 S3 P"1.temp0" Y"thermistor"
M950 H3 C"1.out0" T3
M143 H3 S300
M307 H3 B0 S1.00

M308 S4 P"1.temp1" Y"thermistor"
M950 H4 C"1.out1" T4
M143 H4 S300
M307 H4 B0 S1.00

M302 P0 S140 R140                                             ; Cold extrusion
M308 S10 Y"mcu-temp" A"MCU"

; ============================================================
; FANS
; ============================================================

M950 F0  Q500 C"0.out8"                                       ; T0 Layer
M950 F1  Q500 C"1.out7"                                       ; T1 Layer
M950 F4  Q500 C"0.out7"                                       ; T0 Hotend
M950 F5  Q500 C"1.out6"                                       ; T1 Hotend
M950 F6  Q500 C"0.out9"                                       ; T0 Extra
M950 F7  Q500 C"1.out8"                                       ; T1 Extra
M950 F12 Q500 C"0.out6"                                       ; Filter

; ============================================================
; GPIO / OUTPUTS
; ============================================================

M950 S0 C"0.io7.out"                                          ; BLTouch
M950 P1 Q500 C"0.out3"                                        ; T0 Duo Power
M950 P2 Q500 C"1.out2"                                        ; T1 Duo Power
M950 P3 Q500 C"0.out5"                                        ; LED link
M42  P3 S255

; ============================================================
; Z PROBE
; ============================================================

M558 P9 C"0.io7.in" H5 F120 T6000
M557 P5:5 X{15,global.area[0]-15} Y{15,global.area[1]-15}
G31 X0 Y38.5 Z2 P25

; ============================================================
; TOOLS
; ============================================================

set var.i = 0
while var.i < #global.toolType
	M98 P{"config_" ^ global.toolType[var.i] ^ ".g"} X{var.i} Y{var.toolSide[var.i]}
	set var.i = var.i + 1

M98 P"config_sync.g"

; ============================================================
; USER MODIFIABLE
; ============================================================

M912 P0 S-10
;M21 P1
;M291 P"Visit our <a href=""https://indart3d.com"" target=""_blank"">website</a>" R"Welcome to INDART3D" S1 T29
;M955 P0 C"spi.cs1+spi.cs0" I61
;M551 P"password"

; ============================================================
; FINALIZATION
; ============================================================

M911 S22 R23 P"M98 P""0:/sys/autosave.g"""
M669 T1 S1
M597 X0 U70
T0 P0

if fileexists("0:/sys/config-override.g")
	M501

set var.root = {"0:/data/height_map",  "0:/sys/autopower.g"}
set var.i = 0
while var.i < #var.root
	if fileexists(var.root[var.i])
		M98 P{var.root[var.i]}
	set var.i = var.i + 1